---
// Google Analytics 4.
//
// Paste the measurement ID from the GA4 property here (Admin → Data streams →
// your web stream → "Measurement ID"). While it's the placeholder, nothing is
// injected, so the site builds and runs normally without analytics.
//
// The ID is not a secret — it ships in the page HTML on every request — so it
// lives in the source rather than an env var or CI secret.
const MEASUREMENT_ID = 'G-1WR900MHDR';

// Keep `npm run dev` out of the production numbers. (`npm run preview` serves a
// PROD build, so that one *will* send hits — from localhost.) The format check
// is here because a truncated or whitespace-padded paste would otherwise ship a
// tag that silently collects nothing.
const enabled = import.meta.env.PROD && /^G-[A-Z0-9]{10}$/.test(MEASUREMENT_ID) && MEASUREMENT_ID !== 'G-XXXXXXXXXX';

// Google Search Console ownership proof, only needed if you verify with the
// "HTML tag" method. If you verify via DNS TXT record or via the GA4 tag above,
// leave this empty. Paste just the `content="..."` value, not the whole tag.
const SEARCH_CONSOLE_TOKEN = '';
---

{SEARCH_CONSOLE_TOKEN && <meta name="google-site-verification" content={SEARCH_CONSOLE_TOKEN} />}

{
  enabled && (
    <>
      <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${MEASUREMENT_ID}`} />
      <script is:inline define:vars={{ MEASUREMENT_ID }}>
        window.dataLayer = window.dataLayer || [];
        function gtag() {
          dataLayer.push(arguments);
        }
        window.gtag = gtag;
        gtag('js', new Date());

        // BaseLayout mounts <ClientRouter />, so navigations are client-side
        // swaps, not page loads — the automatic page_view would fire once per
        // session no matter how many pages someone reads. Turn it off and send
        // page_view from `astro:page-load`, which fires on the initial load and
        // on every transition.
        gtag('config', MEASUREMENT_ID, { send_page_view: false });

        // Astro re-runs page scripts after each navigation, so guard the
        // listener the same way WaveBackground guards its rAF loop — otherwise
        // the listeners stack up and one navigation reports 2, 3, 4 page_views.
        if (!window.__gaPageViewBound) {
          window.__gaPageViewBound = true;
          document.addEventListener('astro:page-load', () => {
            gtag('event', 'page_view', {
              page_location: location.href,
              page_title: document.title,
            });
          });
        }
      </script>
    </>
  )
}
