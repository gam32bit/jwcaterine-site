---
interface Props {
  summary: string;
}

const { summary } = Astro.props;
---

<details class="disclosure">
  <summary class="disclosure__summary">{summary}</summary>
  {/* Scrolls its own overflow so a wide table never scrolls the page body. */}
  <div class="disclosure__body"><slot /></div>
</details>

<style>
  .disclosure {
    margin: 2rem 0;
    border: 1px solid #1e3a5f;
    border-radius: 4px;
  }

  .disclosure__summary {
    padding: 0.7rem 1rem;
    color: #cbe4f5;
    font-size: 0.95rem;
    font-weight: 500;
    cursor: pointer;
    list-style: none;
  }

  .disclosure__summary::-webkit-details-marker {
    display: none;
  }

  /* Own marker so the open/closed state reads the same in every browser. */
  .disclosure__summary::before {
    content: '▸';
    display: inline-block;
    width: 1rem;
    color: #7d8ea6;
    transition: transform 0.15s;
  }

  .disclosure[open] .disclosure__summary::before {
    transform: rotate(90deg);
  }

  .disclosure__summary:hover,
  .disclosure__summary:focus-visible {
    color: #e2e8f0;
  }

  .disclosure__body {
    padding: 0.25rem 1rem 1rem;
    overflow-x: auto;
    border-top: 1px solid #1e3a5f;
  }

  @media (prefers-reduced-motion: reduce) {
    .disclosure__summary::before {
      transition: none;
    }
  }
</style>
