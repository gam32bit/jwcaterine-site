---
// No props needed, but you could add color/speed overrides later
---

<canvas id="wave-bg" transition:persist></canvas>

<style>
  #wave-bg {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: -1;
    pointer-events: none;
  }
</style>

<script>
  const canvas = document.getElementById('wave-bg') as HTMLCanvasElement & {
    _waveInit?: boolean;
    _waveParams?: { gravity: number; waves: number; chop: number; swell: number };
    _waveRedraw?: () => void;
  };
  if (!canvas._waveInit) {
    canvas._waveInit = true;
    const ctx = canvas.getContext('2d')!;

    // Draw in CSS pixels regardless of devicePixelRatio, so every tuning
    // constant below means the same visual size on every screen.
    let W = 0;
    let H = 0;
    function resize() {
      const dpr = window.devicePixelRatio || 1;
      W = window.innerWidth;
      H = window.innerHeight;
      canvas.width = W * dpr;
      canvas.height = H * dpr;
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    }
    resize();
    window.addEventListener('resize', () => {
      resize();
      drawOnce(); // repaint the parked frame under prefers-reduced-motion
    });

    // Live-tunable parameters, exposed on the canvas element so page scripts
    // (the home-page sliders) can mutate the running animation. The canvas has
    // transition:persist, so a visitor's tweaks survive client-side navigation.
    const params = {
      // Pseudo-gravity in CSS-px/s². At this field's ~10 px-per-meter scale 95
      // is close to real gravity, putting wave periods in the 3–13 s range of
      // an actual sea. All speeds scale together as sqrt(gravity).
      gravity: 95,
      waves: 1, // amplitude multiplier on the dominant set-making pair
      chop: 1, // amplitude multiplier on the short texture components
      swell: 1, // amplitude multiplier on the whole-field swell
    };
    canvas._waveParams = params;

    // Gerstner wave components, summed to make one shared ocean surface.
    // The two longest wavelengths are deliberately close together: their beat
    // modulates the surface so waves arrive in groups ("sets", ~1 min cycle)
    // instead of a uniform wiggle. Amplitudes fall off steeply — one dominant
    // band reads as waves; equal amplitudes read as noise.
    const components = [
      { wavelength: 520, amp: 15, steepness: 1.6, phase: 0.0, group: 'waves' as const },
      { wavelength: 430, amp: 11, steepness: 1.6, phase: 2.3, group: 'waves' as const },
      { wavelength: 240, amp:  4, steepness: 1.2, phase: 4.1, group: 'chop' as const },
      { wavelength: 120, amp: 1.3, steepness: 0.8, phase: 1.0, group: 'chop' as const },
    ].map(cmp => ({ ...cmp, k: (2 * Math.PI) / cmp.wavelength, travel: 0 }));

    // Big slow swell: one giant wavelength shared by every layer at full strength,
    // so all lines rise and fall together as a single roll passes across.
    const SWELL = {
      k: (2 * Math.PI) / 2400,
      amp: 26,
      steepness: 0.6,
      travel: 0,
    };

    // Each band is the same surface seen at increasing distance: farther bands
    // are fainter (ampScale down), perspective-compressed (kScale up), and
    // offset along the wave direction (phaseShift). Temporal frequency is NOT
    // scaled — distance changes how big a wave looks, not how fast it bobs —
    // which keeps the bands reading as one ocean instead of independent lines.
    const layers = [
      { y: 0.82, ampScale: 1.00, kScale: 1.00, phaseShift: 0.0, color: 'rgba(40,110,170,0.45)', width: 2.5 },
      { y: 0.68, ampScale: 0.78, kScale: 1.07, phaseShift: 1.1, color: 'rgba(60,140,190,0.35)', width: 2.0 },
      { y: 0.55, ampScale: 0.62, kScale: 1.15, phaseShift: 2.6, color: 'rgba(80,165,205,0.28)', width: 1.8 },
      { y: 0.42, ampScale: 0.50, kScale: 1.24, phaseShift: 4.0, color: 'rgba(100,185,215,0.22)', width: 1.5 },
      { y: 0.30, ampScale: 0.40, kScale: 1.34, phaseShift: 5.5, color: 'rgba(120,195,220,0.16)', width: 1.2 },
      { y: 0.20, ampScale: 0.32, kScale: 1.45, phaseShift: 0.7, color: 'rgba(140,205,230,0.10)', width: 1.0 },
    ];

    // The layer where sum(steepness*amp*k) — the crest-looping criterion — is
    // largest, for the steepness auto-clamp in draw().
    const maxLayerQ = Math.max(...layers.map(l => l.ampScale * l.kScale));

    // Respect prefers-reduced-motion (WCAG 2.2.2): render the wave field as a
    // single static frame instead of animating. The loop parks itself
    // (rafId = 0) while the preference is on and resumes if it's lifted;
    // drawOnce repaints the parked frame after resizes or slider changes.
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    let rafId = 0;
    const drawOnce = () => {
      if (rafId === 0) rafId = requestAnimationFrame(draw);
    };
    canvas._waveRedraw = drawOnce;
    reduceMotion.addEventListener('change', () => {
      if (!reduceMotion.matches) drawOnce();
    });

    let last: number | undefined;

    function draw(now: number) {
      // Real-seconds timestep (refresh-rate independent), clamped so a
      // backgrounded tab resumes where it left off instead of jump-cutting.
      const dt = last === undefined ? 0 : Math.min((now - last) / 1000, 0.1);
      last = now;

      // Deep-water dispersion omega = sqrt(g*k): longer waves travel faster,
      // like real swell. Phase is accumulated frame-by-frame (rather than
      // omega*t) so the gravity slider changes speed smoothly instead of
      // teleporting the whole field.
      for (const w of components) w.travel += Math.sqrt(params.gravity * w.k) * dt;
      SWELL.travel += Math.sqrt(params.gravity * SWELL.k) * dt;

      // Auto-clamp steepness so slider-boosted amplitudes can't push
      // sum(steepness*amp*k) past 1, where crests curl into self-intersecting
      // loops. 0.9 leaves a little margin while keeping crests sharp.
      const swellAmp = SWELL.amp * params.swell;
      const swellQak = SWELL.steepness * swellAmp * SWELL.k;
      let compQak = 0;
      for (const w of components) compQak += w.steepness * w.amp * params[w.group] * w.k;
      const sharp = Math.min(1, 0.9 / (compQak * maxLayerQ + swellQak));

      ctx.clearRect(0, 0, W, H);
      for (const l of layers) {
        ctx.beginPath();
        const baseY = H * l.y;
        // Sweep the surface parameter past the canvas edges since x is displaced.
        const margin = 100;
        let first = true;
        for (let u = -margin; u <= W + margin; u += 2) {
          let xDisp = 0;
          let yDisp = 0;
          for (const w of components) {
            const amp = w.amp * params[w.group];
            const theta = w.k * l.kScale * u - w.travel + w.phase + l.phaseShift;
            xDisp -= w.steepness * sharp * amp * Math.sin(theta);
            yDisp += amp * Math.cos(theta);
          }
          const swellTheta = SWELL.k * u - SWELL.travel;
          const swellX = -SWELL.steepness * sharp * swellAmp * Math.sin(swellTheta);
          const swellY = swellAmp * Math.cos(swellTheta);
          const x = u + xDisp * l.ampScale + swellX;
          // Canvas y grows downward, so subtract elevation — otherwise the
          // Gerstner profile renders upside down (sharp troughs, flat crests).
          const y = baseY - (yDisp * l.ampScale + swellY);
          if (first) {
            ctx.moveTo(x, y);
            first = false;
          } else {
            ctx.lineTo(x, y);
          }
        }
        ctx.strokeStyle = l.color;
        ctx.lineWidth = l.width;
        ctx.stroke();
      }
      rafId = reduceMotion.matches ? 0 : requestAnimationFrame(draw);
    }

    rafId = requestAnimationFrame(draw);
  }
</script>
