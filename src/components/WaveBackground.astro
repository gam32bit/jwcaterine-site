---
// No props needed, but you could add color/speed overrides later
---

<canvas id="wave-bg" transition:persist></canvas>

<style>
  #wave-bg {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: -1;
    pointer-events: none;
  }
</style>

<script>
  const c = document.getElementById('wave-bg') as HTMLCanvasElement;
  const ctx = c.getContext('2d')!;

  function resize() {
    c.width = window.innerWidth * devicePixelRatio;
    c.height = window.innerHeight * devicePixelRatio;
  }
  resize();
  window.addEventListener('resize', resize);

  const layers = [
    { amp: 50, freq: 0.003, speed: 0.008, y: 0.82, color: 'rgba(40,110,170,0.45)', width: 2.5 },
    { amp: 40, freq: 0.002,  speed: 0.012, y: 0.68, color: 'rgba(60,140,190,0.35)', width: 2 },
    { amp: 35, freq: 0.0025, speed: 0.006, y: 0.55, color: 'rgba(80,165,205,0.28)', width: 1.8 },
    { amp: 28, freq: 0.003,  speed: 0.01,  y: 0.42, color: 'rgba(100,185,215,0.22)', width: 1.5 },
    { amp: 22, freq: 0.002,  speed: 0.005, y: 0.30, color: 'rgba(120,195,220,0.16)', width: 1.2 },
    { amp: 18, freq: 0.0035, speed: 0.007, y: 0.20, color: 'rgba(140,205,230,0.10)', width: 1 },
  ];

  let t = 0;

  function draw() {
    ctx.clearRect(0, 0, c.width, c.height);
    for (const l of layers) {
      ctx.beginPath();
      for (let x = 0; x <= c.width; x += 3) {
        const y =
          c.height * l.y +
          Math.sin(x * l.freq + t * l.speed) * l.amp +
          Math.sin(x * l.freq * 0.6 + t * l.speed * 0.7 + 1.3) * l.amp * 0.4;
        x === 0 ? ctx.moveTo(x, y) : ctx.lineTo(x, y);
      }
      ctx.strokeStyle = l.color;
      ctx.lineWidth = l.width;
      ctx.stroke();
    }
    t++;
    requestAnimationFrame(draw);
  }

  draw();
</script>
