---
// No props needed, but you could add color/speed overrides later
---

<canvas id="wave-bg" transition:persist></canvas>

<style>
  #wave-bg {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: -1;
    pointer-events: none;
  }
</style>

<script>
  const canvas = document.getElementById('wave-bg') as HTMLCanvasElement & { _waveInit?: boolean };
  if (!canvas._waveInit) {
    canvas._waveInit = true;
    const ctx = canvas.getContext('2d')!;

    function resize() {
      canvas.width = window.innerWidth * devicePixelRatio;
      canvas.height = window.innerHeight * devicePixelRatio;
    }
    resize();
    window.addEventListener('resize', resize);

    // Pseudo-gravity in canvas-pixel units. Tune this to speed up/slow down the whole field.
    const GRAVITY = 0.005;

    // Gerstner wave components, summed to make one shared ocean surface.
    // Different wavelengths whose periods don't share a low common multiple => non-repeating profile.
    const components = [
      { wavelength: 380, amp: 22, steepness: 0.50, phase: 0.0 },
      { wavelength: 220, amp:  9, steepness: 0.30, phase: 1.7 },
      { wavelength: 130, amp:  3, steepness: 0.20, phase: 3.2 },
      { wavelength:  70, amp: 1.5, steepness: 0.15, phase: 5.0 },
    ].map(cmp => {
      const k = (2 * Math.PI) / cmp.wavelength;
      // Deep-water dispersion: longer waves travel faster, like real swell.
      return { ...cmp, k, omega: Math.sqrt(GRAVITY * k) };
    });

    // Big slow swell: one giant wavelength shared by every layer at full strength,
    // so all lines rise and fall together as a single roll passes across.
    const SWELL = (() => {
      const wavelength = 2000;
      const k = (2 * Math.PI) / wavelength;
      return {
        k,
        omega: Math.sqrt(GRAVITY * k),
        amp: 32,
        steepness: 0.4,
        phase: 0,
      };
    })();

    // Each visual band reuses the shared wave field, but with its own k/omega/phase
    // perturbation so the lines don't all crest at the same x or drift in lockstep.
    const layers = [
      { y: 0.82, ampScale: 1.00, kScale: 1.00, omegaScale: 1.00, phaseShift: 0.0, color: 'rgba(40,110,170,0.45)', width: 2.5 },
      { y: 0.68, ampScale: 0.78, kScale: 0.85, omegaScale: 1.15, phaseShift: 1.1, color: 'rgba(60,140,190,0.35)', width: 2.0 },
      { y: 0.55, ampScale: 0.62, kScale: 1.20, omegaScale: 0.90, phaseShift: 2.6, color: 'rgba(80,165,205,0.28)', width: 1.8 },
      { y: 0.42, ampScale: 0.50, kScale: 0.95, omegaScale: 1.30, phaseShift: 4.0, color: 'rgba(100,185,215,0.22)', width: 1.5 },
      { y: 0.30, ampScale: 0.40, kScale: 1.40, omegaScale: 0.75, phaseShift: 5.5, color: 'rgba(120,195,220,0.16)', width: 1.2 },
      { y: 0.20, ampScale: 0.32, kScale: 1.10, omegaScale: 1.05, phaseShift: 0.7, color: 'rgba(140,205,230,0.10)', width: 1.0 },
    ];

    let t = 0;

    function draw() {
      ctx.clearRect(0, 0, canvas.width, canvas.height);
      for (const l of layers) {
        ctx.beginPath();
        const baseY = canvas.height * l.y;
        // Sweep the surface parameter past the canvas edges since x is displaced.
        const margin = 80;
        let first = true;
        for (let u = -margin; u <= canvas.width + margin; u += 3) {
          let xDisp = 0;
          let yDisp = 0;
          for (const w of components) {
            const k = w.k * l.kScale;
            const omega = w.omega * l.omegaScale;
            const theta = k * u - omega * t + w.phase + l.phaseShift;
            xDisp -= w.steepness * w.amp * Math.sin(theta);
            yDisp += w.amp * Math.cos(theta);
          }
          const swellTheta = SWELL.k * u - SWELL.omega * t + SWELL.phase;
          const swellX = -SWELL.steepness * SWELL.amp * Math.sin(swellTheta);
          const swellY = SWELL.amp * Math.cos(swellTheta);
          const x = u + xDisp * l.ampScale + swellX;
          const y = baseY + yDisp * l.ampScale + swellY;
          if (first) {
            ctx.moveTo(x, y);
            first = false;
          } else {
            ctx.lineTo(x, y);
          }
        }
        ctx.strokeStyle = l.color;
        ctx.lineWidth = l.width;
        ctx.stroke();
      }
      t++;
      requestAnimationFrame(draw);
    }

    draw();
  }
</script>
