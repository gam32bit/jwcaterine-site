---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Home">
	<h1 class="site-name">JW Caterine</h1>
    <p>Web & Content Strategist | Aspiring Digital Toolmaker</p>

    <div id="wave-controls" aria-label="Wave controls">
      <label>swell <input type="range" data-param="swell" min="0" max="2" step="0.01" value="1" /></label>
      <label>waves <input type="range" data-param="waves" min="0" max="2" step="0.01" value="1" /></label>
      <label>chop <input type="range" data-param="chop" min="0" max="3" step="0.01" value="1" /></label>
      <label>gravity <input type="range" data-param="gravity" min="15" max="380" step="1" value="95" /></label>
    </div>
</BaseLayout>

<style>
  .site-name {
    font-family: 'Yellowtail', cursive;
    font-weight: 400;
    font-size: 4.5rem;
    color: #e2e8f0;
    line-height: 1.3;
  }

  #wave-controls {
    position: fixed;
    left: 1.5rem;
    bottom: 1.5rem;
    display: grid;
    gap: 0.4rem;
    opacity: 0.45;
    transition: opacity 0.25s ease;
  }

  #wave-controls:hover,
  #wave-controls:focus-within {
    opacity: 1;
  }

  #wave-controls label {
    display: grid;
    grid-template-columns: 3.4rem 7rem;
    align-items: center;
    gap: 0.6rem;
    font-size: 0.7rem;
    letter-spacing: 0.08em;
    color: #94a3b8;
    user-select: none;
    cursor: pointer;
  }

  #wave-controls input[type='range'] {
    -webkit-appearance: none;
    appearance: none;
    width: 100%;
    height: 2px;
    background: #2d4159;
    border-radius: 1px;
    outline-offset: 4px;
    cursor: pointer;
  }

  #wave-controls input[type='range']::-webkit-slider-thumb {
    -webkit-appearance: none;
    appearance: none;
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: #7cb8d8;
    border: none;
  }

  #wave-controls input[type='range']::-moz-range-thumb {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: #7cb8d8;
    border: none;
  }
</style>

<script>
  // Wire the sliders to the live wave-field params that WaveBackground exposes
  // on its persistent canvas. Runs on initial load and again via
  // astro:page-load when client-side navigation returns to this page (the
  // panel is fresh DOM each time; the _wired flag keeps either path from
  // double-binding).
  function wireWaveControls() {
    const panel = document.getElementById('wave-controls') as (HTMLElement & { _wired?: boolean }) | null;
    const canvas = document.getElementById('wave-bg') as (HTMLCanvasElement & { _waveParams?: Record<string, number> }) | null;
    const params = canvas?._waveParams;
    if (!panel || panel._wired || !params) return;
    panel._wired = true;
    for (const input of panel.querySelectorAll<HTMLInputElement>('input[type="range"]')) {
      const key = input.dataset.param!;
      // The canvas (and any tweaks) persist across navigations — reflect the
      // live values rather than the markup defaults.
      input.value = String(params[key]);
      input.addEventListener('input', () => {
        params[key] = Number(input.value);
      });
    }
  }
  wireWaveControls();
  document.addEventListener('astro:page-load', wireWaveControls);
</script>
