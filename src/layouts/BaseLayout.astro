---
const { title } = Astro.props;
import '../styles/global.css';
import WaveBackground from '../components/WaveBackground.astro';
import { ClientRouter } from 'astro:transitions';
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} | Joe Caterine</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Crimson+Pro:ital,wght@0,400;0,500;0,600;0,700;1,400&family=Yellowtail&display=swap"
      rel="stylesheet"
    />
    <ClientRouter />
  </head>
  <body>
      <WaveBackground />
    <nav>
      <a href="/">Home</a>
      <a href="/about">About</a>
      <a href="/blog">Blog</a>
    </nav>

    <main>
      <slot />
    </main>

    <footer>
    </footer>
  </body>
</html>
