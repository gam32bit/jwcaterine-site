---
import '../styles/global.css';
import WaveBackground from '../components/WaveBackground.astro';
import Lightbox from '../components/Lightbox.astro';
import { ClientRouter } from 'astro:transitions';

interface Props {
  title: string;
  description?: string;
  ogType?: string;
  /** Frosted panel behind the content column so text reads calmly over the
      waves. On by default; the home page opts out to keep the full-bleed
      first impression. */
  scrim?: boolean;
}

const { title, description, ogType = 'website', scrim = true } = Astro.props;
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site) : undefined;
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} | Joe Caterine</title>
    {description && <meta name="description" content={description} />}
    {canonical && <link rel="canonical" href={canonical} />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate" type="application/rss+xml" title="Joe Caterine" href="/rss.xml" />
    <meta property="og:site_name" content="Joe Caterine" />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    {canonical && <meta property="og:url" content={canonical} />}
    <meta name="twitter:card" content="summary" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Crimson+Pro:ital,wght@0,400;0,500;0,600;0,700;1,400&family=Yellowtail&display=swap"
      rel="stylesheet"
    />
    <ClientRouter />
  </head>
  <body>
      <WaveBackground />
    <nav>
      <a href="/">Home</a>
      <a href="/about">About</a>
      <a href="/blog">Blog</a>
    </nav>

    <main class:list={[{ scrim }]}>
      <slot />
    </main>

    <Lightbox />
  </body>
</html>
